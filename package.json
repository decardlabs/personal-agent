{
  "name": "personal-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal intelligent work assistant based on CLI agent architecture",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:replay": "vitest run src/testing/replayRunner.test.ts",
    "test:watch": "vitest",
    "migrate": "tsx src/storage/migrate.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "pino": "^9.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
